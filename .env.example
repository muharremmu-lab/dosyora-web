NEXT_PUBLIC_SITE_URL=https://dosyora.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Müşteri uygulaması (ileride app.dosyora.com)
# NEXT_PUBLIC_CUSTOMER_APP_URL=https://app.dosyora.com

# Production (Vercel) — Turso libSQL zorunlu
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# Giden bilgilendirme e-postaları Google Workspace SMTP ile bilgi@dosyora.com adresinden gider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=bilgi@dosyora.com
# SMTP_PASSWORD=
# ADMIN_NOTIFICATION_EMAIL=bilgi@dosyora.com

# Admin panel (production'da zorunlu)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# GibTebligat çevrimdışı lisans imzası. Boşsa masaüstü uygulamasındaki anahtar kullanılır.
# LICENSE_HMAC_SECRET=

# GibTebligat anonim hata telemetrisi
# TELEMETRY_ADMIN_KEY=
# ADMIN_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEMETRY_WEBHOOK_URL=

# BelgeOkumaWeb provisioning (production'da zorunlu)
# BELGEOKUMA_API_BASE_URL=https://app.dosyora.com
# Shared service secret — aynı değer her iki uygulamada kullanılır:
#   dosyora-web inbound:  BELGEOKUMA_INTERNAL_SECRET
#   BelgeOkumaWeb inbound: INTERNAL_SERVICE_SECRET
#   BelgeOkumaWeb outbound to dosyora-web: DOSYORA_WEB_INTERNAL_SECRET
# BELGEOKUMA_INTERNAL_SECRET=

# Local geliştirme — opsiyonel özel dosya yolu
# DATABASE_PATH=./data/dosyora.db
