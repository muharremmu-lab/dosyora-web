NEXT_PUBLIC_SITE_URL=https://dosyora.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Müşteri uygulaması (ileride app.dosyora.com)
# NEXT_PUBLIC_CUSTOMER_APP_URL=https://app.dosyora.com

# Production (Vercel) — Turso libSQL zorunlu
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# E-posta bildirimleri (Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=DOSYORA <noreply@dosyora.com>
# ADMIN_NOTIFICATION_EMAIL=info@dosyora.com

# Admin panel (production'da zorunlu)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Local geliştirme — opsiyonel özel dosya yolu
# DATABASE_PATH=./data/dosyora.db
